   {
    "id": "s4",
    "script": "Released from rest at plus A, displacement follows a cosine. A stiffer spring oscillates faster; a heavier mass takes longer to complete each cycle.",
    "ops": [
     {
      "op": "equation",
      "id": "motion",
      "anchor": {
       "el": "acceleration",
       "side": "below",
       "gap": 0.12
      },
      "latex": "x(t)=A\\cos(\\omega t),\\qquad \\omega=\\sqrt{\\frac{k}{m}}"
     },
     {
      "op": "equation",
      "id": "period",
      "anchor": {
       "el": "motion",
       "side": "below",
       "gap": 0.1
      },
      "latex": "T=\\frac{2\\pi}{\\omega}=2\\pi\\sqrt{\\frac{m}{k}}"
     },
