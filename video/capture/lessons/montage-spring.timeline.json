   {
    "id": "s2",
    "script": "Stretching the spring produces a restoring force toward equilibrium. Hooke\u2019s law makes acceleration proportional to displacement, but opposite in direction.",
    "ops": [
     {
      "op": "figure",
      "id": "force_marks",
      "on": "spring",
      "marks": [
       {
        "kind": "segment",
        "id": "force",
