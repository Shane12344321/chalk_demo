         "at": "launch"
        },
        "from": [
         3,
         0
        ],
        "to": [
         2,
         2
        ],
        "r": 0.12,
        "label": "45\u00b0"
       }
      ]
     }
    ],
    "checkpoint": null
   },
   {
    "id": "s2",
    "script": "A shallow launch has more horizontal speed but less flight time. A steep launch stays airborne longer but moves horizontally more slowly.",
    "ops": [
     {
      "op": "figure",
      "id": "alternatives",
      "on": "flight",
      "marks": [
       {
        "kind": "fn",
        "id": "path30",
        "y": "0.577350269*x-x^2/15",
        "domain": [
         0,
         8.660254
        ],
        "stroke": "dashed",
        "label": "30\u00b0"
       },
       {
        "kind": "fn",
        "id": "path60",
        "y": "1.732050808*x-x^2/5",
        "domain": [
         0,
         8.660254
        ],
        "stroke": "dashed",
        "label": "60\u00b0"
       },
       {
        "kind": "point",
        "id": "shortlanding",
        "at": [
         8.660254,
         0
        ]
       }
      ]
     },
     {
      "op": "equation",
      "id": "components",
      "anchor": {
       "el": "conditions",
       "side": "below",
       "gap": 0.12
      },
      "latex": "v_x=v\\cos\\theta,\\qquad v_y=v\\sin\\theta"
     },
     {
      "op": "equation",
      "id": "time",
      "anchor": {
       "el": "components",
       "side": "below",
       "gap": 0.08
      },
      "latex": "0=v\\sin\\theta\\,T-\\tfrac12gT^2\\quad\\Rightarrow\\quad T=\\frac{2v\\sin\\theta}{g}"
     }
    ],
    "checkpoint": null
   },
   {
    "id": "s3",
    "script": "Range is horizontal speed times flight time. Multiplying produces sine of twice the launch angle; speed and gravity stay fixed.",
    "ops": [
     {
      "op": "figure",
      "id": "rangemark",
      "on": "flight",
      "marks": [
       {
        "kind": "point",
        "id": "landing45",
        "at": {
         "on": "path45",
         "x": 10
        }
       },
       {
        "kind": "measure",
        "from": {
         "at": "launch"
        },
        "to": {
         "at": "landing45"
        },
        "label": "R = 10 m"
       }
      ]
     },
     {
      "op": "equation",
      "id": "range",
      "anchor": {
       "el": "time",
       "side": "below",
       "gap": 0.1
      },
      "latex": "R=v\\cos\\theta\\,T=\\frac{2v^2\\sin\\theta\\cos\\theta}{g}=\\frac{v^2}{g}\\sin(2\\theta)"
     }
    ],
    "checkpoint": {
     "question": "With speed and gravity fixed, what value of sin(2\u03b8) gives the greatest range?",
     "expected_gist": "Its maximum value, 1."
    }
   },
   {
    "id": "s4",
    "script": "Sine reaches its maximum at ninety degrees, so twice the launch angle must be ninety. Thus forty-five degrees balances horizontal speed and flight time.",
    "ops": [
     {
      "op": "equation",
      "id": "maximum",
      "anchor": {
       "el": "range",
       "side": "below",
       "gap": 0.1
      },
      "latex": "\\sin(2\\theta)\\le1\\quad\\Rightarrow\\quad 2\\theta=90^\\circ,\\quad\\boxed{\\theta=45^\\circ}"
     },
     {
      "op": "figure",
      "id": "finish",
      "on": "flight",
      "marks": [
