{"type":"lesson.step","request_id":"cd9685c4-e95f-4720-92e5-000cd699dcb7","step":{"id":"s4","script":"Check a point on the shaded side: two gives eight less than eleven. Every number smaller than three works.","ops":[{"op":"figure","id":"checkmark","on":"numberline","marks":[{"kind":"point","id":"testpoint","at":[2,0]},{"kind":"text","at":[2,-0.55],"text":"2 works"}]},{"op":"equation","id":"check","anchor":{"el":"exclude","side":"below","gap":0.08},"latex":"x=2:\\quad 3(2)+2=8<11"}],"checkpoint":null}}
