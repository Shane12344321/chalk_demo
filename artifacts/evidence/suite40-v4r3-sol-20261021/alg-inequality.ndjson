{"type":"lesson.step","request_id":"cd9685c4-e95f-4720-92e5-000cd699dcb7","step":{"id":"s1","script":"Let’s solve three x plus two is less than eleven, then show every solution on a number line.","ops":[{"op":"equation","id":"problem","region":"A1","latex":"3x+2<11"},{"op":"figure","id":"numberline","region":"right","frame":{"x":[-2,6],"y":[-1,1],"axes":"none"},"marks":[{"kind":"segment","id":"baseline","from":[-1.7,0],"to":[5.7,0],"arrow":true},{"kind":"segment","from":[0,-0.08],"to":[0,0.08]},{"kind":"text","at":[0,-0.3],"text":"0"},{"kind":"segment","from":[3,-0.08],"to":[3,0.08]},{"kind":"text","at":[3,-0.3],"text":"3"}]}],"checkpoint":null}}
{"type":"lesson.step","request_id":"cd9685c4-e95f-4720-92e5-000cd699dcb7","step":{"id":"s2","script":"Subtract two from both sides. Then divide by positive three, so the inequality sign stays the same.","ops":[{"op":"equation","id":"subtract","anchor":{"el":"problem","side":"below","gap":0.08},"latex":"3x<9"},{"op":"equation","id":"solution","anchor":{"el":"subtract","side":"below","gap":0.08},"latex":"x<3"}],"checkpoint":null}}
