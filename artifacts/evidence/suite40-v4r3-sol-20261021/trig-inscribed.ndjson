{"type":"lesson.step","request_id":"6d428298-82fc-4cc2-8e62-b3f5be976df2","step":{"id":"s1","script":"An inscribed angle has its vertex on a circle. Here, angle APB intercepts the arc from A to B that does not contain P.","ops":[{"op":"text","id":"title","region":"A1","content":"Inscribed angle theorem"},{"op":"figure","id":"circlefig","region":"right","frame":{"x":[-3.8,3.8],"y":[-3.7,3.8],"axes":"none"},"marks":[{"kind":"circle","id":"rim","center":[0,0],"r":3},{"kind":"point","id":"a","at":[-2.598076211,-1.5],"label":"A"},{"kind":"point","id":"b","at":[2.598076211,-1.5],"label":"B"},{"kind":"point","id":"p","at":[0,3],"label":"P"},{"kind":"segment","from":{"at":"p"},"to":{"at":"a"}},{"kind":"segment","from":{"at":"p"},"to":{"at":"b"}},{"kind":"angle","at":{"at":"p"},"from":{"at":"a"},"to":{"at":"b"},"r":0.25,"label":"α"}]}],"checkpoint":null}}
{"type":"lesson.step","request_id":"6d428298-82fc-4cc2-8e62-b3f5be976df2","step":{"id":"s2","script":"Join the center to A and B. The inscribed angle is half the central angle subtending the same arc.","ops":[{"op":"figure","id":"central","on":"circlefig","marks":[{"kind":"point","id":"o","at":[0,0],"label":"O"},{"kind":"segment","from":{"at":"o"},"to":{"at":"a"},"stroke":"dashed"},{"kind":"segment","from":{"at":"o"},"to":{"at":"b"},"stroke":"dashed"},{"kind":"angle","at":{"at":"o"},"from":{"at":"a"},"to":{"at":"b"},"r":0.3,"label":"2α"},{"kind":"arc","center":{"at":"o"},"r":3,"start":210,"end":330,"label":"intercepted arc"}]},{"op":"equation","id":"theorem","anchor":{"el":"title","side":"below","gap":0.12},"latex":"\\angle APB=\\frac12\\angle AOB"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"6d428298-82fc-4cc2-8e62-b3f5be976df2","step":{"id":"s3","script":"Here the central angle is 120 degrees, so the inscribed angle is 60 degrees. Always compare angles that intercept the same arc.","ops":[{"op":"figure","id":"values","on":"circlefig","marks":[{"kind":"text","at":[0,-0.85],"text":"120°"},{"kind":"text","at":[0,2.05],"text":"60°"}]},{"op":"equation","id":"example","anchor":{"el":"theorem","side":"below","gap":0.12},"latex":"\\angle APB=\\frac12(120^\\circ)=60^\\circ"}],"checkpoint":{"question":"If the central angle over the same arc were 100°, what would the inscribed angle be?","expected_gist":"50°, half the central angle"}}}
