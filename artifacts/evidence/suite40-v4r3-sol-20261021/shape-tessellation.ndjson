{"type":"lesson.step","request_id":"c4749610-381f-47ba-9ba1-0ae6ee5ac806","step":{"id":"s2","script":"Six triangles meet at one vertex. Their angles make a full turn, leaving neither a gap nor an overlap.","ops":[{"op":"figure","id":"six_tiles","on":"tiles","marks":[{"kind":"group","rotate":60,"repeat":5,"origin":[0,0],"marks":[{"kind":"polyline","points":[[0,0],[1,1.732050808],[-1,1.732050808]],"closed":true,"fill":true}]}]},{"op":"equation","id":"full_turn","anchor":{"el":"angle_value","side":"below","gap":0.12},"latex":"6\\times60^\\circ=360^\\circ"}],"checkpoint":{"question":"Why do six equilateral triangles fit exactly around a vertex?","expected_gist":"Six 60° angles total 360°, a full turn."}}}
