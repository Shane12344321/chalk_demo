{"type":"lesson.step","request_id":"aa9fa9a0-c69f-42ce-b40d-8f459c5b1728","step":{"id":"s2","script":"One fifth of a full turn moves each tip to the next tip. The entire outline matches again after seventy-two degrees.","ops":[{"op":"figure","id":"turn","on":"star","marks":[{"kind":"point","id":"tip_a","at":[0,3]},{"kind":"point","id":"tip_b","at":[-2.853,0.927]},{"kind":"segment","from":{"at":"center"},"to":{"at":"tip_a"},"stroke":"dashed"},{"kind":"segment","from":{"at":"center"},"to":{"at":"tip_b"},"stroke":"dashed"},{"kind":"arc","center":{"at":"center"},"r":1.65,"start":90,"end":162,"arrow":true,"label":"72°"}]},{"op":"equation","id":"angle","anchor":{"el":"title","side":"below","gap":0.12},"latex":"\\text{Smallest turn}=\\frac{360^\\circ}{5}=72^\\circ"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"aa9fa9a0-c69f-42ce-b40d-8f459c5b1728","step":{"id":"s3","script":"Five equal turns complete the circle. Counting the matching positions, including the full turn, gives rotational symmetry of order five.","ops":[{"op":"figure","id":"all_turns","on":"star","marks":[{"kind":"group","repeat":5,"rotate":72,"marks":[{"kind":"arc","center":[0,0],"r":0.7,"start":18,"end":90,"arrow":true}]},{"kind":"text","at":[0,-2.9],"text":"5 matching positions","size":"small"}]},{"op":"equation","id":"order","anchor":{"el":"angle","side":"below","gap":0.12},"latex":"\\text{Order}=\\frac{360^\\circ}{72^\\circ}=5"}],"checkpoint":{"question":"Would a 36° turn make this star match its original outline?","expected_gist":"No; the smallest matching positive turn is 72°."}}}
