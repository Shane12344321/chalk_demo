{"type":"lesson.step","request_id":"e4e9eae2-60e4-4d36-acc1-f85cd60b98e5","step":{"id":"s1","script":"A definite integral measures signed area between a curve and the horizontal axis. Start with the constant function y equals two.","ops":[{"op":"text","id":"title","region":"A1","content":"Definite integral = signed area"},{"op":"diagram","id":"area_graph","region":"right","primitives":[{"kind":"rect","from":[0.2,0.35],"to":[0.75,0.8],"stroke":"dashed","fill":true,"meaning":"Area under y equals two from x equals zero to three"},{"kind":"line","points":[[0.12,0.8],[0.92,0.8]],"stroke":"solid","arrow":true,"label":"x"},{"kind":"line","points":[[0.2,0.88],[0.2,0.12]],"stroke":"solid","arrow":true,"label":"y"},{"kind":"line","points":[[0.2,0.35],[0.88,0.35]],"stroke":"solid","label":"y = 2"},{"kind":"text","at":[0.15,0.86],"content":"0"},{"kind":"text","at":[0.75,0.86],"content":"3"}]}],"checkpoint":null}}
