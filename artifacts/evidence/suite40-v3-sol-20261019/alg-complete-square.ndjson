{"type":"lesson.step","request_id":"c9a64723-64ee-4cd0-b7f2-6fd9c69835f4","step":{"id":"s1","script":"Complete the square for x squared plus six x plus five. For the area picture, assume x is positive; the resulting identity holds for every x.","ops":[{"op":"equation","id":"expression","region":"A1","latex":"x^2+6x+5"},{"op":"diagram","id":"area","region":"right","primitives":[{"kind":"rect","from":[0.12,0.15],"to":[0.62,0.65],"stroke":"solid"},{"kind":"text","at":[0.37,0.4],"content":"x²","size":"large"},{"kind":"text","at":[0.37,0.1],"content":"x"},{"kind":"text","at":[0.07,0.4],"content":"x"}]}],"checkpoint":null}}
{"type":"lesson.step","request_id":"c9a64723-64ee-4cd0-b7f2-6fd9c69835f4","step":{"id":"s2","script":"Split six x into two equal strips. Each strip has length x and width three, placed on adjacent sides of the original square.","ops":[{"op":"line","id":"right_top","canvas_id":"area","from":[0.62,0.15],"to":[0.82,0.15],"stroke":"solid","label":"3"},{"op":"line","id":"right_edge","canvas_id":"area","from":[0.82,0.15],"to":[0.82,0.65],"stroke":"solid"},{"op":"line","id":"bottom_left","canvas_id":"area","from":[0.12,0.65],"to":[0.12,0.85],"stroke":"solid","label":"3"},{"op":"line","id":"bottom_edge","canvas_id":"area","from":[0.12,0.85],"to":[0.62,0.85],"stroke":"solid"}],"checkpoint":{"question":"What area is missing from the corner to make one large square?","expected_gist":"A three-by-three corner, with area nine."}}}
{"type":"lesson.step","request_id":"c9a64723-64ee-4cd0-b7f2-6fd9c69835f4","step":{"id":"s3","script":"The missing corner is three by three, so add nine. The completed square has side x plus three.","ops":[{"op":"line","id":"corner_right","canvas_id":"area","from":[0.82,0.65],"to":[0.82,0.85],"stroke":"dashed"},{"op":"line","id":"corner_bottom","canvas_id":"area","from":[0.62,0.85],"to":[0.82,0.85],"stroke":"dashed"},{"op":"point","id":"corner_area","canvas_id":"area","at":[0.72,0.75],"label":"9"},{"op":"equation","id":"square_identity","anchor":{"el":"expression","side":"below","gap":0.1},"latex":"x^2+6x+9=(x+3)^2"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"c9a64723-64ee-4cd0-b7f2-6fd9c69835f4","step":{"id":"s4","script":"Our expression had five, not nine. Subtract four from the completed square to preserve its value.","ops":[{"op":"equation","id":"adjustment","anchor":{"el":"square_identity","side":"below","gap":0.08},"latex":"x^2+6x+5=(x+3)^2-4"}],"checkpoint":null}}
