{"type":"lesson.step","request_id":"2843d4b0-3c99-49a6-8540-4c63c62de40a","step":{"id":"s1","script":"Each circle is a sound pulse emitted earlier. The source moves right, so successive circles have centers farther right.","ops":[{"op":"text","id":"title","region":"A1","content":"Doppler effect"},{"op":"diagram","id":"waves","region":"right","primitives":[{"kind":"ellipse","center":[0.38,0.5],"radius":[0.3,0.3],"stroke":"solid","meaning":"oldest pulse, centered at an earlier source position"},{"kind":"ellipse","center":[0.44,0.5],"radius":[0.2,0.2],"stroke":"solid","meaning":"middle pulse, centered farther right"},{"kind":"ellipse","center":[0.5,0.5],"radius":[0.1,0.1],"stroke":"solid","meaning":"newest pulse, centered nearest the moving source"},{"kind":"point","at":[0.56,0.5],"label":"source"},{"kind":"text","at":[0.5,0.9],"content":"Equally timed pulses","size":"small"}]},{"op":"text","id":"assume","anchor":{"el":"title","side":"below","gap":0.08},"content":"Still air; source slower than sound"}],"checkpoint":null}}
