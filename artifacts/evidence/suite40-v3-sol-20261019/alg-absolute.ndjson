{"type":"lesson.step","request_id":"e667d3b7-c19d-4607-b0b0-089cb83a1467","step":{"id":"s1","script":"Absolute value measures distance from zero. On this number line, negative three lies three units to the left of zero.","ops":[{"op":"text","id":"title","region":"A1","content":"Absolute value = distance from zero"},{"op":"diagram","id":"numberline","region":"right","primitives":[{"kind":"line","points":[[0.08,0.5],[0.92,0.5]],"stroke":"solid","arrow":true,"meaning":"Number line increasing to the right"},{"kind":"line","points":[[0.2,0.48],[0.2,0.52]],"stroke":"solid"},{"kind":"line","points":[[0.3,0.48],[0.3,0.52]],"stroke":"solid"},{"kind":"line","points":[[0.4,0.48],[0.4,0.52]],"stroke":"solid"},{"kind":"line","points":[[0.5,0.48],[0.5,0.52]],"stroke":"solid"},{"kind":"line","points":[[0.6,0.48],[0.6,0.52]],"stroke":"solid"},{"kind":"line","points":[[0.7,0.48],[0.7,0.52]],"stroke":"solid"},{"kind":"line","points":[[0.8,0.48],[0.8,0.52]],"stroke":"solid"},{"kind":"text","at":[0.2,0.59],"content":"−3"},{"kind":"text","at":[0.3,0.59],"content":"−2"},{"kind":"text","at":[0.4,0.59],"content":"−1"},{"kind":"text","at":[0.5,0.59],"content":"0"},{"kind":"text","at":[0.6,0.59],"content":"1"},{"kind":"text","at":[0.7,0.59],"content":"2"},{"kind":"text","at":[0.8,0.59],"content":"3"},{"kind":"point","at":[0.2,0.5]}]}],"checkpoint":null}}
{"type":"lesson.step","request_id":"e667d3b7-c19d-4607-b0b0-089cb83a1467","step":{"id":"s2","script":"Count three unit intervals from zero to negative three. The distance is three, not negative three: distance cannot be negative.","ops":[{"op":"arrow","id":"leftdistance","canvas_id":"numberline","from":[0.5,0.37],"to":[0.2,0.37],"stroke":"solid","label":"3 units"},{"op":"equation","id":"negativevalue","anchor":{"el":"title","side":"below","gap":0.08},"latex":"|-3|=3"}],"checkpoint":{"question":"What is the absolute value of positive three?","expected_gist":"Three, because positive three is also three units from zero."}}}
{"type":"lesson.step","request_id":"e667d3b7-c19d-4607-b0b0-089cb83a1467","step":{"id":"s3","script":"Positive three is equally far from zero. Opposite numbers have the same absolute value; the bars report distance, not direction.","ops":[{"op":"point","id":"positivepoint","canvas_id":"numberline","at":[0.8,0.5]},{"op":"arrow","id":"rightdistance","canvas_id":"numberline","from":[0.5,0.72],"to":[0.8,0.72],"stroke":"solid","label":"3 units"},{"op":"equation","id":"positivevalue","anchor":{"el":"negativevalue","side":"below","gap":0.08},"latex":"|3|=|-3|=3"},{"op":"equation","id":"nonnegative","anchor":{"el":"positivevalue","side":"below","gap":0.08},"latex":"|x|\\geq 0"}],"checkpoint":null}}
