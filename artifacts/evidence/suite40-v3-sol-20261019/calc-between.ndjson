{"type":"lesson.step","request_id":"7b57da62-3527-4675-9f9b-09e6d4b0742e","step":{"id":"s1","script":"Find the area enclosed by y equals x and y equals x squared. Between zero and one, the straight line lies above the parabola.","ops":[{"op":"text","id":"title","region":"A1","content":"Area between two curves"},{"op":"axes","id":"axes","region":"right","x":{"min":-0.1,"max":1.2,"label":"x"},"y":{"min":-0.1,"max":1.2,"label":"y"}},{"op":"curve","id":"upper","axes_id":"axes","expr":"x","domain":[0,1]},{"op":"curve","id":"lower","axes_id":"axes","expr":"x^2","domain":[0,1]}],"checkpoint":null}}
{"type":"lesson.warning","request_id":"7b57da62-3527-4675-9f9b-09e6d4b0742e","code":"step_repaired","step_hint":"s2"}
{"type":"lesson.step","request_id":"7b57da62-3527-4675-9f9b-09e6d4b0742e","step":{"id":"s2","script":"The curves meet at zero and one. These intersections set our integration limits; subtract the lower curve from the upper curve.","ops":[{"op":"point","id":"start","construct":{"kind":"along","element_id":"upper","t":0},"label":"(0, 0)"},{"op":"point","id":"finish","construct":{"kind":"along","element_id":"upper","t":1},"label":"(1, 1)"},{"op":"equation","id":"integral","anchor":{"el":"title","side":"below","gap":0.08},"latex":"A=\\int_0^1\\left(x-x^2\\right)\\,dx"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"7b57da62-3527-4675-9f9b-09e6d4b0742e","step":{"id":"s3","script":"Each vertical slice has height upper minus lower. Integrating these heights gives one sixth of a square unit.","ops":[{"op":"point","id":"uppermark","construct":{"kind":"along","element_id":"upper","t":0.5},"label":"upper"},{"op":"point","id":"lowermark","construct":{"kind":"along","element_id":"lower","t":0.5},"label":"lower"},{"op":"equation","id":"result","anchor":{"el":"integral","side":"below","gap":0.08},"latex":"A=\\left[\\frac{x^2}{2}-\\frac{x^3}{3}\\right]_0^1=\\frac12-\\frac13=\\boxed{\\frac16}"}],"checkpoint":null}}
