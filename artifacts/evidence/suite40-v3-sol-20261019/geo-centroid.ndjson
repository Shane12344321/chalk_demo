{"type":"lesson.step","request_id":"e2a8c930-d3ea-4f70-9f05-f1ee0c166fc1","step":{"id":"s1","script":"Start with triangle ABC. A median connects a vertex to the midpoint of the opposite side.","ops":[{"op":"text","id":"title","region":"A1","content":"Medians of a triangle"},{"op":"line","id":"sideab","region":"right","from":[0.15,0.8],"to":[0.45,0.14],"stroke":"solid","label":"AB"},{"op":"line","id":"sidebc","canvas_id":"sideab","from":[0.45,0.14],"to":[0.85,0.8],"stroke":"solid","label":"BC"},{"op":"line","id":"sideca","canvas_id":"sideab","from":[0.85,0.8],"to":[0.15,0.8],"stroke":"solid","label":"CA"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"e2a8c930-d3ea-4f70-9f05-f1ee0c166fc1","step":{"id":"s2","script":"Mark the midpoint of each side. Each midpoint divides its side into two equal lengths.","ops":[{"op":"point","id":"midab","construct":{"kind":"along","element_id":"sideab","t":0.5},"label":"F"},{"op":"point","id":"midbc","construct":{"kind":"along","element_id":"sidebc","t":0.5},"label":"D"},{"op":"point","id":"midca","construct":{"kind":"along","element_id":"sideca","t":0.5},"label":"E"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"e2a8c930-d3ea-4f70-9f05-f1ee0c166fc1","step":{"id":"s3","script":"Join each vertex to the opposite midpoint. These three segments are the medians. Notice where they cross.","ops":[{"op":"line","id":"medianad","canvas_id":"sideab","from":[0.15,0.8],"to":[0.65,0.47],"stroke":"dashed"},{"op":"line","id":"medianbe","canvas_id":"sideab","from":[0.45,0.14],"to":[0.5,0.8],"stroke":"dashed"},{"op":"line","id":"mediancf","canvas_id":"sideab","from":[0.85,0.8],"to":[0.3,0.47],"stroke":"dashed"}],"checkpoint":{"question":"Do the three medians meet at one point or at three different points?","expected_gist":"All three medians meet at one point."}}}
{"type":"lesson.step","request_id":"e2a8c930-d3ea-4f70-9f05-f1ee0c166fc1","step":{"id":"s4","script":"All three medians meet at one point called the centroid, G. This happens in every triangle.","ops":[{"op":"point","id":"centroid","construct":{"kind":"intersection_of","a":"medianad","b":"medianbe"},"label":"G"},{"op":"text","id":"conclusion","anchor":{"el":"title","side":"below","gap":0.08},"content":"G is the centroid: all three medians meet here."}],"checkpoint":null}}
