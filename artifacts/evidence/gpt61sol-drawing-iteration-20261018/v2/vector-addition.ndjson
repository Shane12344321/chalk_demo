{"type":"lesson.step","request_id":"78d13969-f227-456d-b37b-7f9de292c6f0","step":{"id":"s3","script":"The sum connects the first tail to the final head. Add corresponding components: three right and two up.","ops":[{"op":"sketch","id":"sumvec","region":"left","strokes":[[[0.15,0.8],[0.65,0.3]],[[0.57,0.33],[0.65,0.3],[0.62,0.38]]]},{"op":"text","id":"sumlabel","anchor":{"el":"blabel","side":"below","gap":0.08},"content":"\\vec a+\\vec b=(3+0,0+2)=(3,2)"},{"op":"text","id":"rule","anchor":{"el":"sumlabel","side":"below","gap":0.08},"content":"Head-to-tail: first tail \\to final head"}],"checkpoint":null}}
