{"type":"lesson.step","request_id":"78d13969-f227-456d-b37b-7f9de292c6f0","step":{"id":"s1","script":"Start with vector a: three units to the right. Its arrow shows both direction and magnitude.","ops":[{"op":"sketch","id":"avec","region":"left","strokes":[[[0.15,0.8],[0.65,0.8]],[[0.59,0.76],[0.65,0.8],[0.59,0.84]]]},{"op":"text","id":"alabel","region":"right","content":"\\vec a = (3,0)"}],"checkpoint":null}}
