{"type":"lesson.step","request_id":"3c12a65b-8456-4389-a02b-39eb50d5e03d","step":{"id":"s1","script":"We will construct a line that cuts segment AB exactly in half and meets it at a right angle.","ops":[{"op":"text","id":"title","region":"A1","content":"Perpendicular bisector"},{"op":"figure","id":"construction","region":"right","frame":{"x":[-2.7,2.7],"y":[-2.9,2.9],"axes":"none"},"marks":[{"kind":"point","id":"a","at":[-2,0],"label":"A"},{"kind":"point","id":"b","at":[2,0],"label":"B"},{"kind":"segment","id":"ab","from":{"at":"a"},"to":{"at":"b"}}]}],"checkpoint":null}}
{"type":"lesson.step","request_id":"3c12a65b-8456-4389-a02b-39eb50d5e03d","step":{"id":"s2","script":"Open your compass wider than half AB. Draw arcs above and below from A, then repeat from B without changing the opening.","ops":[{"op":"figure","id":"compass_arcs","on":"construction","marks":[{"kind":"arc","id":"arc_a","center":{"at":"a"},"r":3,"start":-65,"end":65,"stroke":"dashed"},{"kind":"arc","id":"arc_b","center":{"at":"b"},"r":3,"start":115,"end":245,"stroke":"dashed"}]},{"op":"text","id":"compass_note","anchor":{"el":"title","side":"below","gap":0.1},"content":"Keep the compass opening fixed"},{"op":"equation","id":"radius_rule","anchor":{"el":"compass_note","side":"below","gap":0.08},"latex":"r>\\frac{AB}{2}"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"3c12a65b-8456-4389-a02b-39eb50d5e03d","step":{"id":"s3","script":"Label the two arc intersections P and Q. Use a straightedge to join them. Both intersections are equally far from A and B.","ops":[{"op":"figure","id":"join_crossings","on":"construction","marks":[{"kind":"point","id":"p","at":[0,2.2360679775],"label":"P"},{"kind":"point","id":"q","at":[0,-2.2360679775],"label":"Q"},{"kind":"segment","id":"bisector","from":{"at":"q"},"to":{"at":"p"}}]},{"op":"equation","id":"equal_radii","anchor":{"el":"radius_rule","side":"below","gap":0.12},"latex":"PA=PB,\\qquad QA=QB"}],"checkpoint":{"question":"Why is P equally far from A and B?","expected_gist":"Both arcs were drawn with the same compass radius."}}}
{"type":"lesson.step","request_id":"3c12a65b-8456-4389-a02b-39eb50d5e03d","step":{"id":"s4","script":"Call the crossing M. Line PQ is the perpendicular bisector: M is the midpoint, and the crossing angle is ninety degrees.","ops":[{"op":"figure","id":"mark_result","on":"construction","marks":[{"kind":"point","id":"m","at":{"mid":["a","b"]},"label":"M"},{"kind":"angle","at":{"at":"m"},"from":{"at":"b"},"to":{"at":"p"},"r":0.14}]},{"op":"equation","id":"result","anchor":{"el":"equal_radii","side":"below","gap":0.12},"latex":"AM=MB,\\qquad PQ\\perp AB"}],"checkpoint":null}}
