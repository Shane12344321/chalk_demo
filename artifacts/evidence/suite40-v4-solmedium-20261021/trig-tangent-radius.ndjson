{"type":"lesson.step","request_id":"3c3dd6e8-8e10-496c-86a4-cc69ef100545","step":{"id":"s1","script":"Draw a radius from the circle’s center O to a point P on its edge.","ops":[{"op":"text","id":"title","region":"C1","content":"Radius meets tangent"},{"op":"figure","id":"circle_fig","region":"left","frame":{"x":[-2.6,3.2],"y":[-2.6,2.6],"axes":"none"},"marks":[{"kind":"circle","id":"circle","center":[0,0],"r":2},{"kind":"point","id":"center","at":[0,0],"label":"O"},{"kind":"point","id":"contact","at":[2,0],"label":"P"},{"kind":"segment","id":"radius","from":{"at":"center"},"to":{"at":"contact"},"label":"r"}]},{"op":"equation","id":"radius_eq","anchor":{"el":"title","side":"below","gap":0.08},"latex":"OP=r"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"3c3dd6e8-8e10-496c-86a4-cc69ef100545","step":{"id":"s2","script":"The tangent touches the circle only at P. Choose another point Q on this tangent.","ops":[{"op":"figure","id":"add_tangent","on":"circle_fig","marks":[{"kind":"segment","id":"tangent","from":[2,-2.4],"to":[2,2.4]},{"kind":"text","at":[2.45,-1.7],"text":"t"},{"kind":"point","id":"other","at":{"on":"tangent","t":0.875},"label":"Q"}]},{"op":"text","id":"contact_note","anchor":{"el":"radius_eq","side":"below","gap":0.08},"content":"Tangent: one point of contact"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"3c3dd6e8-8e10-496c-86a4-cc69ef100545","step":{"id":"s3","script":"The radius to the point of contact is perpendicular to the tangent. So the angle between OP and PQ is ninety degrees.","ops":[{"op":"figure","id":"mark_right","on":"circle_fig","marks":[{"kind":"angle","at":{"at":"contact"},"from":{"at":"other"},"to":{"at":"center"},"r":0.16}]},{"op":"equation","id":"result","anchor":{"el":"contact_note","side":"below","gap":0.08},"latex":"OP\\perp t,\\qquad \\angle OPQ=90^\\circ"}],"checkpoint":{"question":"Which radius is perpendicular to the tangent?","expected_gist":"The radius drawn to the point of contact."}}}
