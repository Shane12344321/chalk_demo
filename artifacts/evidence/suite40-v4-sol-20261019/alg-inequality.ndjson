{"type":"lesson.step","request_id":"a27d7f83-6c71-4e2a-858a-f771a21da046","step":{"id":"s1","script":"Let's solve negative two x plus three is less than seven, then show all the solutions on a number line.","ops":[{"op":"text","id":"title","region":"A1","content":"Solve and graph"},{"op":"equation","id":"original","anchor":{"el":"title","side":"below","gap":0.08},"latex":"-2x+3<7"},{"op":"figure","id":"numberline","region":"right","frame":{"x":[-5,4],"y":[-1,1.5],"axes":"none"},"marks":[{"kind":"segment","from":[-4.5,0],"to":[3.5,0],"arrow":true},{"kind":"segment","from":[-4,-0.1],"to":[-4,0.1]},{"kind":"text","at":[-4,-0.4],"text":"−4"},{"kind":"segment","from":[-2,-0.1],"to":[-2,0.1]},{"kind":"text","at":[-2,-0.4],"text":"−2"},{"kind":"segment","from":[0,-0.1],"to":[0,0.1]},{"kind":"text","at":[0,-0.4],"text":"0"},{"kind":"segment","from":[2,-0.1],"to":[2,0.1]},{"kind":"text","at":[2,-0.4],"text":"2"}]}],"checkpoint":null}}
