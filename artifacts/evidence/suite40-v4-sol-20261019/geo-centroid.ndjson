{"type":"lesson.step","request_id":"c3688515-d8b2-43c3-8b08-0d33f33f59b6","step":{"id":"s1","script":"A median joins a vertex to the midpoint of the opposite side. Here, M divides side BC into two equal lengths.","ops":[{"op":"text","id":"title","region":"A1","content":"Medians and the centroid"},{"op":"figure","id":"triangle","region":"right","frame":{"x":[-0.6,6.6],"y":[-0.7,5.1],"axes":"none"},"marks":[{"kind":"point","id":"a","at":[1.5,4.5],"label":"A"},{"kind":"point","id":"b","at":[0,0],"label":"B"},{"kind":"point","id":"c","at":[6,0],"label":"C"},{"kind":"polyline","points":[{"at":"a"},{"at":"b"},{"at":"c"}],"closed":true},{"kind":"point","id":"m","at":{"mid":["b","c"]},"label":"M"},{"kind":"segment","id":"am","from":{"at":"a"},"to":{"at":"m"}},{"kind":"measure","from":{"at":"b"},"to":{"at":"m"},"label":"3"},{"kind":"measure","from":{"at":"m"},"to":{"at":"c"},"label":"3"}]},{"op":"equation","id":"midpoint","anchor":{"el":"title","side":"below","gap":0.08},"latex":"BM=MC\\quad\\Rightarrow\\quad AM\\text{ is a median}"}],"checkpoint":null}}
