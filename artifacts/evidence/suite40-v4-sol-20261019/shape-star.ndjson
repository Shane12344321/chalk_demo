{"type":"lesson.step","request_id":"fd2df29e-9e4a-4e3e-a1f2-f2bd339e9eef","step":{"id":"s1","script":"This regular five-pointed star has five identical tips arranged around its center. Rotational symmetry means turning it until it matches its starting outline.","ops":[{"op":"text","id":"title","region":"A1","content":"Rotational symmetry"},{"op":"figure","id":"star","region":"right","frame":{"x":[-3.7,3.7],"y":[-3.2,3.7],"axes":"none"},"marks":[{"kind":"polyline","id":"outline","points":[[0,3],[-0.674,0.927],[-2.853,0.927],[-1.09,-0.354],[-1.763,-2.427],[0,-1.146],[1.763,-2.427],[1.09,-0.354],[2.853,0.927],[0.674,0.927]],"closed":true},{"kind":"point","id":"center","at":[0,0],"label":"center"},{"kind":"point","id":"tip","at":[0,3]},{"kind":"segment","id":"radius","from":{"at":"center"},"to":{"at":"tip"},"stroke":"dashed"}]}],"checkpoint":null}}
{"type":"lesson.step","request_id":"fd2df29e-9e4a-4e3e-a1f2-f2bd339e9eef","step":{"id":"s2","script":"Turn counterclockwise by one tip-spacing. Every tip takes the next tip’s place, so the entire star matches again.","ops":[{"op":"figure","id":"turn","on":"star","marks":[{"kind":"point","id":"nexttip","at":[-2.853,0.927]},{"kind":"segment","from":{"at":"center"},"to":{"at":"nexttip"},"stroke":"dashed"},{"kind":"arc","center":{"at":"center"},"r":1.7,"start":90,"end":162,"arrow":true,"label":"72°"}]},{"op":"equation","id":"angle","anchor":{"el":"title","side":"below","gap":0.08},"latex":"\\text{Smallest turn}=\\frac{360^\\circ}{5}=72^\\circ"}],"checkpoint":{"question":"How many matching positions occur during one full turn, counting the full turn but not the starting position?","expected_gist":"Five matching positions, one every 72 degrees."}}}
{"type":"lesson.step","request_id":"fd2df29e-9e4a-4e3e-a1f2-f2bd339e9eef","step":{"id":"s3","script":"Five equal turns complete a full revolution. We call this rotational symmetry of order five; the full turn counts as the fifth match.","ops":[{"op":"figure","id":"matches","on":"star","marks":[{"kind":"group","origin":[0,0],"rotate":72,"repeat":5,"marks":[{"kind":"segment","from":[0,3.15],"to":[0,3.4]}]},{"kind":"text","at":[0,-2.95],"text":"5 matching positions","size":"small"}]},{"op":"equation","id":"turns","anchor":{"el":"angle","side":"below","gap":0.08},"latex":"72^\\circ,\\ 144^\\circ,\\ 216^\\circ,\\ 288^\\circ,\\ 360^\\circ"},{"op":"text","id":"order","anchor":{"el":"turns","side":"below","gap":0.08},"content":"Order of rotational symmetry = 5"}],"checkpoint":null}}
