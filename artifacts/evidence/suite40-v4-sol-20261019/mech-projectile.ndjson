{"type":"lesson.step","request_id":"2cfab343-eff1-453d-9d0c-66b9446dffec","step":{"id":"s1","script":"Ignoring air resistance, a projectile moves horizontally at constant velocity while gravity accelerates it downward.","ops":[{"op":"text","id":"title","region":"A1","content":"Projectile velocity"},{"op":"figure","id":"flight","region":"right","frame":{"x":[-0.5,9],"y":[-0.7,4.5],"axes":"edge","equal_scale":true,"x_label":"x (m)","y_label":"y (m)"},"marks":[{"kind":"param","id":"path","x":"4*t","y":"8*t-5*t^2","t":[0,1.6]},{"kind":"point","id":"launch","at":{"on":"path","t":0},"label":"launch"}]},{"op":"equation","id":"initial","anchor":{"el":"title","side":"below","gap":0.08},"latex":"v_{x0}=4\\,\\mathrm{m/s},\\quad v_{y0}=8\\,\\mathrm{m/s}"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"2cfab343-eff1-453d-9d0c-66b9446dffec","step":{"id":"s2","script":"At equal time intervals, horizontal velocity arrows stay identical. With no horizontal force, horizontal acceleration is zero.","ops":[{"op":"figure","id":"horizontal","on":"flight","marks":[{"kind":"point","id":"up","at":{"on":"path","t":0.25}},{"kind":"point","id":"top","at":{"on":"path","t":0.5}},{"kind":"point","id":"down","at":{"on":"path","t":0.75}},{"kind":"segment","from":{"at":"up"},"to":[2.8,2.4],"arrow":true,"label":"4 m/s"},{"kind":"segment","from":{"at":"top"},"to":[4.4,3.2],"arrow":true,"label":"4 m/s"},{"kind":"segment","from":{"at":"down"},"to":[6,2.4],"arrow":true,"label":"4 m/s"}]},{"op":"equation","id":"vxlaw","anchor":{"el":"initial","side":"below","gap":0.08},"latex":"a_x=0\\quad\\Rightarrow\\quad v_x=v_{x0}"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"2cfab343-eff1-453d-9d0c-66b9446dffec","step":{"id":"s3","script":"Taking upward as positive, gravity reduces vertical velocity. Here we approximate gravitational acceleration as ten meters per second squared.","ops":[{"op":"figure","id":"vertical","on":"flight","marks":[{"kind":"segment","from":{"at":"up"},"to":[1.6,3.6],"arrow":true,"label":"+4 m/s"},{"kind":"text","at":[3.2,3.85],"text":"vᵧ = 0","size":"small"},{"kind":"segment","from":{"at":"down"},"to":[4.8,1.2],"arrow":true,"label":"−4 m/s"}]},{"op":"equation","id":"vylaw","anchor":{"el":"vxlaw","side":"below","gap":0.08},"latex":"a_y=-g,\\qquad v_y=v_{y0}-gt"},{"op":"equation","id":"example","anchor":{"el":"vylaw","side":"below","gap":0.06},"latex":"g\\approx10\\,\\mathrm{m/s^2}:\\quad v_y=8-10t"}],"checkpoint":null}}
