{"type":"lesson.step","request_id":"2cfab343-eff1-453d-9d0c-66b9446dffec","step":{"id":"s4","script":"At the highest point, only vertical velocity is zero. The projectile still moves horizontally, and gravity still accelerates it downward.","ops":[{"op":"figure","id":"apexnote","on":"flight","marks":[{"kind":"segment","from":{"at":"top"},"to":[3.2,1.7],"arrow":true,"stroke":"dashed","label":"g"},{"kind":"text","at":[5.5,3.9],"text":"top: t = 0.8 s","size":"small"}]},{"op":"equation","id":"apexvelocity","anchor":{"el":"example","side":"below","gap":0.08},"latex":"\\text{At the top:}\\quad v_y=0,\\quad v_x=4\\,\\mathrm{m/s}"}],"checkpoint":null}}
