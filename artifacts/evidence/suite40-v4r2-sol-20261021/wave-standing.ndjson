{"type":"lesson.step","request_id":"df874e2c-74b8-4c13-9865-4f79553e7814","step":{"id":"s3","script":"Antinodes sit halfway between adjacent nodes. These points move the most, oscillating between the two extreme curves.","ops":[{"op":"figure","id":"antinodes","on":"string","marks":[{"kind":"point","id":"anti1","at":{"on":"crest","x":1.5},"label":"A"},{"kind":"point","id":"anti2","at":{"on":"crest","x":4.5},"label":"A"},{"kind":"segment","from":{"on":"opposite","x":1.5},"to":{"on":"crest","x":1.5},"arrow":true},{"kind":"segment","from":{"on":"crest","x":4.5},"to":{"on":"opposite","x":4.5},"arrow":true}]},{"op":"text","id":"antidef","anchor":{"el":"nodedef","side":"below","gap":0.1},"content":"Antinode: largest oscillation amplitude"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"df874e2c-74b8-4c13-9865-4f79553e7814","step":{"id":"s4","script":"Adjacent nodes are half a wavelength apart. A node and its nearest antinode are a quarter wavelength apart.","ops":[{"op":"figure","id":"spacing","on":"string","marks":[{"kind":"measure","from":[0,-1.35],"to":[3,-1.35],"label":"λ/2"},{"kind":"measure","from":[0,1.35],"to":[1.5,1.35],"label":"λ/4"}]},{"op":"equation","id":"distances","anchor":{"el":"antidef","side":"below","gap":0.1},"latex":"d_{NN}=\\frac{\\lambda}{2},\\qquad d_{NA}=\\frac{\\lambda}{4}"}],"checkpoint":null}}
