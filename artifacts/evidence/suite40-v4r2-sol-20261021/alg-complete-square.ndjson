{"type":"lesson.step","request_id":"f2834ea1-1d73-4970-aac1-b8d7cf0e4c77","step":{"id":"s2","script":"Split four x into two equal strips, each with area two x. Place one above the square and one beside it.","ops":[{"op":"figure","id":"strips","on":"model","marks":[{"kind":"polyline","id":"topstrip","points":[[0,3],[3,3],[3,5],[0,5]],"closed":true,"fill":true},{"kind":"polyline","id":"sidestrip","points":[[3,0],[5,0],[5,3],[3,3]],"closed":true,"fill":true},{"kind":"text","at":[1.5,4],"text":"2x"},{"kind":"text","at":[4,1.5],"text":"2x"},{"kind":"measure","from":[3,-0.35],"to":[5,-0.35],"label":"2"},{"kind":"measure","from":[-0.35,3],"to":[-0.35,5],"label":"2"}]},{"op":"equation","id":"split","anchor":{"el":"start","side":"below","gap":0.08},"latex":"x^2+2x+2x"}],"checkpoint":null}}
