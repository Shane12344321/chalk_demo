{"type":"lesson.step","request_id":"f2834ea1-1d73-4970-aac1-b8d7cf0e4c77","step":{"id":"s4","script":"Our original expression did not include that corner. Subtract its area back off: the completed square minus four gives the original expression.","ops":[{"op":"figure","id":"cornernote","on":"model","marks":[{"kind":"segment","from":[5.65,4.7],"to":[4.5,4.2],"arrow":true},{"kind":"text","at":[5.05,5.05],"text":"−4","size":"small"}]},{"op":"equation","id":"result","anchor":{"el":"completed","side":"below","gap":0.08},"latex":"\\boxed{x^2+4x=(x+2)^2-4}"}],"checkpoint":null}}
