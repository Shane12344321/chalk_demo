{"type":"lesson.step","request_id":"78093763-f1c4-42cd-9ae2-032d30fe0a8a","step":{"id":"s2","script":"Multiplying outside sine doubles every height. The peaks reach two, but the cycle still takes two pi.","ops":[{"op":"figure","id":"stretch","on":"waves","marks":[{"kind":"fn","id":"doubleheight","y":"2*sin(x)","domain":[0,6.283185307]},{"kind":"point","id":"highpeak","at":{"on":"doubleheight","x":1.570796327},"label":"2 sin x"},{"kind":"segment","from":[1.570796327,0],"to":{"at":"highpeak"},"stroke":"dashed"},{"kind":"measure","from":[0.35,0],"to":[0.35,2],"label":"2"}]},{"op":"equation","id":"heightinfo","anchor":{"el":"baseinfo","side":"below","gap":0.1},"latex":"y=2\\sin x:\\quad A=2,\\quad T=2\\pi"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"78093763-f1c4-42cd-9ae2-032d30fe0a8a","step":{"id":"s3","script":"Multiplying x inside sine makes the cycle run twice as fast. Two complete cycles now fit between zero and two pi.","ops":[{"op":"figure","id":"compress","on":"waves","marks":[{"kind":"fn","id":"doublefreq","y":"sin(2*x)","domain":[0,6.283185307]},{"kind":"point","id":"fastpeak","at":{"on":"doublefreq","x":0.785398163},"label":"sin 2x"},{"kind":"measure","from":[0,-2.2],"to":[3.141592654,-2.2],"label":"π"},{"kind":"measure","from":[3.141592654,-2.2],"to":[6.283185307,-2.2],"label":"π"}]},{"op":"equation","id":"freqinfo","anchor":{"el":"heightinfo","side":"below","gap":0.1},"latex":"y=\\sin(2x):\\quad A=1,\\quad T=\\frac{2\\pi}{2}=\\pi"}],"checkpoint":null}}
