{"type":"lesson.step","request_id":"bebc79ee-c941-40d6-afa9-ddc7f295e397","step":{"id":"s1","script":"Absolute value tells us how far a number is from zero. Start with zero on a number line.","ops":[{"op":"text","id":"title","region":"A1","content":"Absolute value = distance from zero"},{"op":"figure","id":"numberline","region":"right","frame":{"x":[-5,5],"y":[-1.8,2.2],"axes":"none"},"marks":[{"kind":"segment","id":"line","from":[-4.7,0],"to":[4.7,0],"arrow":true},{"kind":"point","id":"zero","at":[0,0],"label":"0"},{"kind":"point","id":"positive","at":[3,0],"label":"3"},{"kind":"point","id":"negative","at":[-3,0],"label":"−3"}]}],"checkpoint":null}}
{"type":"lesson.step","request_id":"bebc79ee-c941-40d6-afa9-ddc7f295e397","step":{"id":"s2","script":"Three is three units to the right of zero. Its absolute value is three.","ops":[{"op":"figure","id":"rightdistance","on":"numberline","marks":[{"kind":"measure","from":{"at":"zero"},"to":{"at":"positive"},"label":"3 units"}]},{"op":"equation","id":"positiveabs","anchor":{"el":"title","side":"below","gap":0.1},"latex":"|3|=3"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"bebc79ee-c941-40d6-afa9-ddc7f295e397","step":{"id":"s3","script":"Negative three is also three units from zero. Direction changes, but distance does not.","ops":[{"op":"figure","id":"leftdistance","on":"numberline","marks":[{"kind":"measure","from":{"at":"negative"},"to":{"at":"zero"},"label":"3 units"}]},{"op":"equation","id":"negativeabs","anchor":{"el":"positiveabs","side":"below","gap":0.1},"latex":"|-3|=3"}],"checkpoint":{"question":"What is |−4|, and why?","expected_gist":"4, because −4 is four units from zero."}}}
{"type":"lesson.step","request_id":"bebc79ee-c941-40d6-afa9-ddc7f295e397","step":{"id":"s4","script":"Zero has no distance from itself. Absolute value is always zero or positive; distance cannot be negative.","ops":[{"op":"figure","id":"zeronote","on":"numberline","marks":[{"kind":"text","at":[0,-1],"text":"0 units from zero","size":"small"}]},{"op":"equation","id":"zeroabs","anchor":{"el":"negativeabs","side":"below","gap":0.1},"latex":"|0|=0"},{"op":"equation","id":"nonnegative","anchor":{"el":"zeroabs","side":"below","gap":0.1},"latex":"|x|\\geq 0"}],"checkpoint":null}}
