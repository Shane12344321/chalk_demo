{"type":"lesson.step","request_id":"d12cb3d6-feb6-4e80-bb32-10ade9b2690c","step":{"id":"s1","script":"Start with a golden rectangle. Removing its largest square leaves a smaller rectangle with the same proportions.","ops":[{"op":"figure","id":"golden","region":"left","frame":{"x":[-0.4,8.5],"y":[-0.4,5.4],"axes":"none"},"marks":[{"kind":"polyline","id":"outline","points":[[0,0],[8.09017,0],[8.09017,5],[0,5]],"closed":true},{"kind":"segment","id":"cut1","from":[5,0],"to":[5,5]},{"kind":"text","at":[2.5,2.5],"text":"square"},{"kind":"measure","from":[0,5.2],"to":[5,5.2],"label":"5"}]},{"op":"text","id":"title","region":"C1","content":"Nested golden rectangles"},{"op":"equation","id":"ratio","anchor":{"el":"title","side":"below","gap":0.08},"latex":"\\varphi=\\frac{1+\\sqrt5}{2}\\approx1.618"},{"op":"equation","id":"similar","anchor":{"el":"ratio","side":"below","gap":0.08},"latex":"\\frac{5\\varphi}{5}=\\frac{5}{5\\varphi-5}=\\varphi"}],"checkpoint":null}}
{"type":"lesson.step","request_id":"d12cb3d6-feb6-4e80-bb32-10ade9b2690c","step":{"id":"s2","script":"Repeat the square removal, turning clockwise each time. Each new square has side length divided by the golden ratio.","ops":[{"op":"figure","id":"nest","on":"golden","marks":[{"kind":"segment","from":[5,1.90983],"to":[8.09017,1.90983]},{"kind":"segment","from":[6.18034,0],"to":[6.18034,1.90983]},{"kind":"segment","from":[5,1.18034],"to":[6.18034,1.18034]},{"kind":"text","at":[6.55,3.5],"text":"3.09"},{"kind":"text","at":[7.15,0.95],"text":"1.91"},{"kind":"text","at":[5.59,0.55],"text":"1.18","size":"small"}]},{"op":"equation","id":"sides","anchor":{"el":"similar","side":"below","gap":0.12},"latex":"s_n=\\frac{5}{\\varphi^n}\\quad(n=0,1,2,\\ldots)"}],"checkpoint":{"question":"By what factor does each successive square's side length shrink?","expected_gist":"Each side is multiplied by 1/φ, approximately 0.618."}}}
